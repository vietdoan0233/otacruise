KIDE_EVENT_URL=https://kide.app/fi/events/bd92ef0f-b02f-4a0b-b439-580b4c01bb2a
DRY_RUN=false
HEADLESS=false
KIDE_WATCH_FOREVER=true
KIDE_KEEP_BROWSER_OPEN=true
KIDE_MAX_WAIT_MS=1800000
KIDE_POLL_INTERVAL_MS=3000

# Preferred: connect to a locally authenticated browser started with CDP.
# Do not put credentials or bearer tokens in this file.
# KIDE_CDP_URL=http://127.0.0.1:9222

# Default: persist the authenticated browser session locally for future runs.
# `.local/` is gitignored; the automation never prints or exports its cookies.
KIDE_PROFILE_DIR=.local/kide-profile

# Alternative session-state file. This is read when set instead of the profile.
# Keep it outside version control and never put credentials in this file manually.
# KIDE_STORAGE_STATE=.local/auth-state.json
PLAYWRIGHT_EXECUTABLE_PATH=

# Keep authentication local. Never commit tokens, cookies, or payment data.
# Use a persistent browser profile or an ignored Playwright storage-state file.
